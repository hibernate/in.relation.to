!!! XML

%feed{ 'xml:lang'=>'en-US', :xmlns=>'http://www.w3.org/2005/Atom' }
  %id= "#{page.content_url}/"
  %title= escape_once( page.title )
  - if ( not site.author.nil? )
    %author
      - if ( defined?( site.author.name ) )
        %name= site.author.name
        - if ( site.author.email )
          %email= site.author.email
      - else
        %name= site.author
  - unless page.entries.empty?
    %updated= page.entries.first.input_mtime.xmlschema
    %link{:rel=>"self",      :type=>"application/atom+xml", :href=>"#{site.base_url}#{page.url}" }
    %link{:rel=>"alternate", :type=>"text/html",            :href=>"#{page.content_url}/" }
    - for entry in page.entries
      %entry
        %id #{site.base_url}#{entry.url}
        %title= escape_once( entry.title )
        %updated= entry.date.xmlschema
        %published= entry.date.xmlschema
        %link{:rel=>"alternate", :type=>"text/html", :href=>"#{site.base_url}#{entry.url}" }
        - if ( not entry.author.nil? )
          - # Reloaded feed entries only carry the first author in 'author', use 'authors' for the rest
          - entry_authors = entry.author.is_a?(Array) ? entry.author : (entry.authors.kind_of?(Array) && !entry.authors.empty? ? entry.authors : [entry.author])
          - for entry_author in entry_authors
            %author
              - if ( defined?( entry_author.name ) )
                %name= entry_author.name.force_encoding("UTF-8")
                - if ( entry_author.email )
                  %email= entry_author.email
              - else
                - author_name = entry_author.kind_of?(Hash) ? (entry_author[:name] || entry_author['name']) : entry_author.to_s
                %name= author_name.force_encoding("UTF-8")
        - if ( not entry.tags.nil? )
          - if entry.tags.is_a? String
            - for tag in entry.tags.split(",").map(&:strip)
              %category{:term=>"#{tag}"}
          - else
            - for tag in entry.tags
              %category{:term=>"#{tag}"}
        %summary
          #{summarize( html_to_text( entry.content.force_encoding("UTF-8") ), 100 )}
        %content{:type=>'html'}
          = clean_html( html_escape( fully_qualify_urls( site.base_url, find_and_preserve( entry.content.force_encoding("UTF-8") ) ) ) )
