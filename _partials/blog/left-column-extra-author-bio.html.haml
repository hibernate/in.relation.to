- real_page = page['real_page']

- # The page subtitle is named after the author, which stays correct for
- # posts with multiple authors
- author_name = real_page.subtitle
- author_name = real_page.posts[0].author[0].to_s if author_name.nil? && !real_page.posts.nil? && !real_page.posts.empty?
- member = site.people.values.detect{|member| member.name == author_name} unless author_name.nil?

- if member && member.content && !member.content.empty?
  %hr
  .bio
    %h2 Bio
    .ui.card.fluid
      .content
        %strong= member.name
      - if member.gravatar_hash
        .image.author-image-container
          .author-image
            %img.author-image{:src=>"https://www.gravatar.com/avatar/#{member.gravatar_hash}?s=300", :height=>300, :width=>300}
      .content
        #{member.content}
      - if member.website
        .extra.content
          %a(href="#{member.website}")
            %i.icon.world
            Website
      - if member.twitter
        .extra.content
          %a(href="#{member.twitter}")
            %i.icon.twitter
            Twitter
